# Caura managed service or self-hosted deployment.
CAURA_API_URL=https://caura.ai/api/v1
CAURA_API_KEY=mc_your_key_here
# Used by simulate.py for direct contradiction-status polling.
CAURA_TENANT_ID=your_tenant_id_here
CAURA_FLEET_ID=fleet-longrun-research
LLM_GATEWAY_API_KEY=your_llm_key_here

# OpenClaw gateway (default: http://127.0.0.1:18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Existing deployments may keep non-empty MEMCLAW_* aliases; CAURA_* wins when both are set. # legacy-name-ok: supported non-empty env fallback
